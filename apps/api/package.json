{
  "name": "@geops/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-isolation=none test/mdm-oauth.test.mjs && tsx --test test/foundation.test.ts",
    "migrate": "node dist/db/migrate.js",
    "mdm:dev": "node mdm-oauth-dev.mjs"
  },
  "dependencies": {
    "@geops/api-contracts": "0.1.0",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
