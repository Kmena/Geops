{
  "name": "@geops/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-isolation=none test/mdm-oauth.test.mjs test/mdm-oauth-secret-export.test.mjs && tsx --test test/foundation.test.ts test/mdm-provider.test.ts test/mdm-real.test.ts test/mdm-disabled.test.ts && node --import tsx --test test/staging-cookie.test.mjs && node --import tsx --test --test-isolation=none test/gps-continuity.unit.test.mjs",
    "migrate": "node dist/db/migrate.js",
    "migration:test": "tsx --test test/migration-target.test.ts",
    "gps:integration": "node --import tsx test/gps-policy.integration.mjs",
    "device:enrollment:integration": "node --import tsx test/device-enrollment.integration.mjs",
    "mdm:integration": "node --import tsx test/mdm-inventory.integration.mjs",
    "mdm:security:integration": "node --import tsx test/mdm-security.integration.mjs",
    "gps:health:integration": "node --import tsx test/gps-health.integration.mjs",
    "gps:config:integration": "node --import tsx test/gps-config.integration.mjs",
    "gps:events:integration": "node --import tsx test/gps-events.integration.mjs",
    "gps:operations:integration": "node --import tsx test/gps-operations.integration.mjs",
    "gps:capability:integration": "node --import tsx test/gps-capability-bootstrap.integration.mjs",
    "admin:tenant:integration": "node --import tsx test/admin-tenant-bootstrap.integration.mjs",
    "admin:users:integration": "node --import tsx test/single-tenant-users.integration.mjs",
    "maintenance:integration": "node --import tsx test/maintenance-upgrade.integration.mjs",
    "maintenance:recovery:integration": "node --import tsx test/maintenance-recovery.integration.mjs",
    "maintenance:recovery:versions": "node --import tsx test/maintenance-recovery-versions.integration.mjs",
    "migration:0015:integration": "node --import tsx test/migration-0015-upgrade.integration.mjs",
    "release:restore:integration": "node --import tsx test/single-tenant-release-restore.integration.mjs",
    "maintenance:cli:rehearsal": "node --import tsx test/maintenance-cli-rehearsal.integration.mjs",
    "maintenance:recover": "node dist/db/maintenance-recovery-cli.js",
    "gps:scheduler:load": "node --import tsx test/gps-scheduler-load.integration.mjs",
    "gps:continuity:integration": "node --import tsx test/gps-continuity.integration.mjs",
    "gps:continuity:migration:integration": "node --import tsx test/gps-continuity-migration.integration.mjs",
    "mdm:dev": "node mdm-oauth-dev.mjs",
    "admin:bootstrap": "node dist/admin-auth/bootstrap.js",
    "admin:recovery": "node dist/admin-auth/recovery.js",
    "admin:gps-capabilities": "node dist/admin-auth/gps-capability-cli.js"
  },
  "dependencies": {
    "@geops/api-contracts": "0.1.0",
    "argon2": "^0.40.3",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
