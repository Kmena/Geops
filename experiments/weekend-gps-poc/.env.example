# Ejemplo público; no copiar secretos reales a este archivo.
POC_ENV_ID=weekend-gps-poc-v1
POC_DB_PASSWORD=REPLACE_WITH_NEW_EXPERIMENTAL_PASSWORD
POC_ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_SALT_COLON_HASH
POC_RETENTION_HOURS=72
POC_CAPTURE_ENABLED=false
# Usar EC2 Public IPv4 verificada o FQDN propio; nunca IP privada ni placeholder en cloud.
POC_PUBLIC_HOST=REPLACE_WITH_VERIFIED_PUBLIC_IPV4_OR_OWNED_FQDN
POC_HTTP_BIND=REPLACE_AFTER_PORT_INVENTORY
POC_HTTPS_BIND=REPLACE_AFTER_PORT_INVENTORY
# Solo para ejecutar API Node sin Compose:
POC_DATABASE_URL=postgresql://poc_user:REPLACE@localhost:5432/geops_poc
POC_PUBLIC_ORIGIN=https://REPLACE_WITH_VERIFIED_PUBLIC_HOST
POC_MAX_DEVICES=1
POC_PORT=3600
POC_SECURE_COOKIE=true
